# Firebase web app configuration.
# Copy this file to `.env` and fill in the values from the Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
#
# These values are public by design: Vite inlines VITE_-prefixed variables into the
# client bundle. Access is protected by Firestore Security Rules, not secrecy.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Privileged content-sync credentials do NOT belong in this file. `npm run content:sync`
# reads GOOGLE_APPLICATION_CREDENTIALS or FIREBASE_SERVICE_ACCOUNT_JSON from the runtime
# environment only. Never commit service-account keys or CI secrets.
