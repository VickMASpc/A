VITE_FIREBASE_AUTH_DOMAIN="jp-app-b2406.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="jp-app-b2406"
VITE_FIREBASE_STORAGE_BUCKET="jp-app-b2406.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="15733135468"
VITE_FIREBASE_APP_ID="1:15733135468:web:ce8cb92794c7f1c71de049"

# Privileged content-sync credentials do NOT belong in this file. `npm run content:sync`
# reads GOOGLE_APPLICATION_CREDENTIALS or FIREBASE_SERVICE_ACCOUNT_JSON from the runtime
